##
## Vyatta/DANOS networking kernel configuration
## This featureset adds networking enhancements for router/NOS use
##

##
## file: net/mpls/Kconfig
##
CONFIG_MPLS=y
CONFIG_NET_MPLS_GSO=y
CONFIG_MPLS_ROUTING=m
CONFIG_MPLS_IPTUNNEL=m

##
## file: net/netfilter/Kconfig
##
# Ensure netfilter is built for our bypass target
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=m

##
## file: net/ipv4/Kconfig
##
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_MROUTE=y
CONFIG_IP_MROUTE_MULTIPLE_TABLES=y

##
## file: net/ipv6/Kconfig
##
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_MROUTE=y
CONFIG_IPV6_MROUTE_MULTIPLE_TABLES=y

##
## file: drivers/net/team/Kconfig
##
CONFIG_NET_TEAM=m
CONFIG_NET_TEAM_MODE_ACTIVEBACKUP=m
CONFIG_NET_TEAM_MODE_LOADBALANCE=m
CONFIG_NET_TEAM_MODE_ROUNDROBIN=m
CONFIG_NET_TEAM_MODE_BROADCAST=m
CONFIG_NET_TEAM_MODE_RANDOM=m

##
## file: drivers/net/Kconfig
##
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_NETCONSOLE=m
