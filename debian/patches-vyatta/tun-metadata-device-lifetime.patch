Subject: tun: hold the metadata input device while receiving a packet

Keep lookup in the TUN network namespace and hold a reference until delivery.

--- a/drivers/net/tun.c
+++ b/drivers/net/tun.c
@@ -1839,6 +1839,7 @@
 	u32 rxhash = 0;
 	struct tun_meta meta = { .flags = 0 };
 	struct net_device *dev = tun->dev;
+	struct net_device *meta_dev = NULL;
 	int skb_xdp = 1;
 	bool frags = tun_napi_frags_enabled(tfile);
 	enum skb_drop_reason drop_reason = SKB_DROP_REASON_NOT_SPECIFIED;
@@ -1954,9 +1955,9 @@
 	}
 
 	if (meta.flags & TUN_META_FLAG_IIF) {
-		dev = __dev_get_by_index(dev_net(tun->dev), meta.iif);
-		if (!dev)
-			dev = tun->dev;
+		meta_dev = dev_get_by_index(dev_net(tun->dev), meta.iif);
+		if (meta_dev)
+			dev = meta_dev;
 	}
 	skb->dev = dev;
 	switch (tun->flags & TUN_TYPE_MASK) {
@@ -2083,6 +2084,7 @@
 			napi_free_frags(&tfile->napi);
 			rcu_read_unlock();
 			mutex_unlock(&tfile->napi_mutex);
+			dev_put(meta_dev);
 			return err;
 		}
 
@@ -2131,6 +2133,7 @@
 	if (rxhash)
 		tun_flow_update(tun, rxhash, tfile);
 
+	dev_put(meta_dev);
 	return total_len;
 
 drop:
@@ -2147,6 +2150,7 @@
 		mutex_unlock(&tfile->napi_mutex);
 	}
 
+	dev_put(meta_dev);
 	return err ?: total_len;
 }
 
