tun: add Vyatta extensions

Extensions to allow masqurade of ethtool info and device statistics.

Signed-off-by: Stephen Hemminger <stephen@networkplumber.org>

---
 drivers/net/tun.c              |   52 +++++++++++++++++++++++++++++++++--------
 include/uapi/linux/if_tunnel.h |    8 ++++++
 2 files changed, 50 insertions(+), 10 deletions(-)

--- a/drivers/net/tun.c
+++ b/drivers/net/tun.c
@@ -52,6 +52,7 @@
 #include <linux/if_arp.h>
 #include <linux/if_ether.h>
 #include <linux/if_tun.h>
+#include <linux/if_tunnel.h>
 #include <linux/if_vlan.h>
 #include <linux/crc32.h>
 #include <linux/math.h>
@@ -211,6 +212,10 @@ struct tun_struct {
 	struct tun_prog __rcu *steering_prog;
 	struct tun_prog __rcu *filter_prog;
 	struct ethtool_link_ksettings link_ksettings;
+
+	/* Vyatta extensions for remote statistics and speed */
+	char		hw_driver[32];
+	char		hw_bus[ETHTOOL_BUSINFO_LEN];
 	/* init args */
 	struct file *file;
 	struct ifreq *ifr;
@@ -980,6 +985,11 @@ static int tun_net_init(struct net_devic
 
 	spin_lock_init(&tun->lock);
 
+	strscpy(tun->hw_driver, DRV_NAME, sizeof(tun->hw_driver));
+	strscpy(tun->hw_bus,
+		(ifr->ifr_flags & IFF_TUN) ? "tun" : "tap",
+		sizeof(tun->hw_bus));
+
 	err = security_tun_dev_alloc_security(&tun->security);
 	if (err < 0)
 		return err;
@@ -1167,6 +1177,35 @@ static netdev_features_t tun_net_fix_fea
 	return (features & tun->set_features) | (features & ~TUN_USER_FEATURES);
 }
 
+static int
+tun_net_set_info(struct net_device *dev, const void __user *data)
+{
+	struct tun_struct *tun = netdev_priv(dev);
+	struct tunnel_lower info;
+
+	if (!capable(CAP_NET_ADMIN))
+		return -EPERM;
+
+	if (copy_from_user(&info, data, sizeof(info)))
+		return -EFAULT;
+
+	strscpy(tun->hw_driver, info.driver, sizeof(tun->hw_driver));
+	strscpy(tun->hw_bus, info.bus, sizeof(tun->hw_bus));
+	return 0;
+}
+
+static int
+tun_net_ioctl(struct net_device *dev, struct ifreq *ifr,
+	      void __user *data, int cmd)
+{
+	switch (cmd) {
+	case SIOCTUNNELINFO:
+		return tun_net_set_info(dev, data);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
 static void tun_set_headroom(struct net_device *dev, int new_hr)
 {
 	struct tun_struct *tun = netdev_priv(dev);
@@ -1335,6 +1374,7 @@ static const struct net_device_ops tap_n
 	.ndo_start_xmit		= tun_net_xmit,
 	.ndo_fix_features	= tun_net_fix_features,
 	.ndo_set_rx_mode	= tun_net_mclist,
+	.ndo_siocdevprivate	= tun_net_ioctl,
 	.ndo_set_mac_address	= eth_mac_addr,
 	.ndo_validate_addr	= eth_validate_addr,
 	.ndo_select_queue	= tun_select_queue,
@@ -3601,17 +3641,9 @@ static void tun_get_drvinfo(struct net_d
 {
 	struct tun_struct *tun = netdev_priv(dev);
 
-	strscpy(info->driver, DRV_NAME, sizeof(info->driver));
+	strscpy(info->driver, tun->hw_driver, sizeof(info->driver));
 	strscpy(info->version, DRV_VERSION, sizeof(info->version));
-
-	switch (tun->flags & TUN_TYPE_MASK) {
-	case IFF_TUN:
-		strscpy(info->bus_info, "tun", sizeof(info->bus_info));
-		break;
-	case IFF_TAP:
-		strscpy(info->bus_info, "tap", sizeof(info->bus_info));
-		break;
-	}
+	strscpy(info->bus_info, tun->hw_bus, sizeof(info->bus_info));
 }
 
 static u32 tun_get_msglevel(struct net_device *dev)
--- a/include/uapi/linux/if_tunnel.h
+++ b/include/uapi/linux/if_tunnel.h
@@ -22,6 +22,14 @@
 #define SIOCDEL6RD      (SIOCDEVPRIVATE + 10)
 #define SIOCCHG6RD      (SIOCDEVPRIVATE + 11)
 
+/* Vyatta extension for setting tunnel info from application */
+#define SIOCTUNNELINFO	(SIOCDEVPRIVATE + 15)
+
+struct tunnel_lower {
+	char driver[32];
+	char bus[32];
+};
+
 #define GRE_CSUM	__cpu_to_be16(0x8000)
 #define GRE_ROUTING	__cpu_to_be16(0x4000)
 #define GRE_KEY		__cpu_to_be16(0x2000)
